/* Config. do TypeScript: ver typescriptlang.org/docs/handbook/tsconfig-json.html */
/* Opções do compilador Angular: ver angular.dev/reference/configs/angular-compiler-options */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
